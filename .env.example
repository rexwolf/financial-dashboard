# Financial Dashboard API Keys
# Copy this file to .env and add your actual API keys

# Alpha Vantage API (Required for stocks, commodities, market indexes)
# Get your free API key at: https://www.alphavantage.co/support/#api-key
REACT_APP_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI (Required for market events)
# Get your free API key at: https://newsapi.org/register
REACT_APP_NEWSAPI_KEY=your_newsapi_key_here

# Polygon API (Optional - for additional stock data)
# Get your free API key at: https://polygon.io/
REACT_APP_POLYGON_API_KEY=your_polygon_key_here

# Environment
REACT_APP_ENVIRONMENT=development

# Note: 
# - CoinGecko API requires no key for basic usage
# - ExchangeRate-API requires no key for basic usage
# - These APIs provide reliable, real-time financial data
# - Never commit your actual .env file to version control